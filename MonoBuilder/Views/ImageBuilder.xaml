<Window
    x:Class="MonoBuilder.Views.ViewUtils.ImageBuilder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MonoBuilder.Views.ViewUtils"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:MonoBuilder.Models.helpers"
    xmlns:vm="clr-namespace:MonoBuilder.ViewModels.ImageModel"
    xmlns:vmbase="clr-namespace:MonoBuilder.ViewModels"
    Title="MonoBuilder | Image Builder"
    Width="{Binding CurrentWindowWidth, Mode=TwoWay}"
    Height="600"
    MinWidth="600"
    d:DataContext="{d:DesignInstance Type=vm:ImageViewModel,
                                     IsDesignTimeCreatable=True}"
    Style="{StaticResource WindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <utils:ImageSourceToImageBrushConverter x:Key="ImageToBrush" />
        <utils:IntegerToStringConverter x:Key="IntToString" />
    </Window.Resources>

    <Grid x:Name="MainContent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="225" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <Viewbox
                Grid.Column="0"
                Margin="10"
                Stretch="Uniform">
                <Rectangle Width="{Binding ContainerWidth}" Height="{Binding ContainerHeight}">
                    <Rectangle.Fill>
                        <Binding Converter="{StaticResource ImageToBrush}" Path="ImagePreview">
                            <Binding.TargetNullValue>
                                <ImageBrush
                                    AlignmentX="Center"
                                    AlignmentY="Center"
                                    ImageSource="/Assets/fallback.jpg"
                                    Stretch="Fill"
                                    TileMode="Tile"
                                    Viewport="0,0,33.33,33.33"
                                    ViewportUnits="Absolute" />
                            </Binding.TargetNullValue>
                        </Binding>
                    </Rectangle.Fill>
                </Rectangle>
            </Viewbox>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <TextBlock
                    VerticalAlignment="Bottom"
                    FontSize="13"
                    Text="Dimensions (?)"
                    TextWrapping="Wrap"
                    ToolTip="Not indicative of actual width or height." />
                <TextBox
                    Grid.Row="1"
                    Margin="4"
                    Padding="0"
                    Style="{StaticResource DefaultTextBox}"
                    Tag="Width Value..."
                    Text="{Binding ContainerWidth, Mode=TwoWay, Converter={StaticResource IntToString}, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Row="2"
                    Margin="4"
                    Padding="0"
                    Style="{StaticResource DefaultTextBox}"
                    Tag="Height Value..."
                    Text="{Binding ContainerHeight, Mode=TwoWay, Converter={StaticResource IntToString}, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Grid>
        <Grid
            x:Name="EditingContent"
            Grid.Row="1"
            MaxWidth="1250">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding EditingContentColumnWidth}" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.Row="1"
                MaxWidth="1250"
                Margin="10,0,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TabControl
                    x:Name="ImageFilterTabs"
                    Grid.Row="0"
                    Height="40"
                    Margin="3,5,3,0"
                    Background="#111111"
                    BorderBrush="Maroon"
                    DockPanel.Dock="Top"
                    ItemsSource="{Binding DataTabs.Tabs}"
                    SelectedItem="{Binding SelectedTab}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Header" Value="{Binding Name}" />
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <TabControl.ContentTemplate>
                        <DataTemplate />
                    </TabControl.ContentTemplate>
                </TabControl>
                <DataGrid
                    x:Name="ImagesDataGrid"
                    Grid.Row="1"
                    Width="{Binding TotalWindowWidth}"
                    MaxWidth="970"
                    Margin="{Binding DataGridMargin}"
                    AutoGenerateColumns="False"
                    BorderThickness="{Binding DataGridBorderThickness}"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    DockPanel.Dock="Top"
                    HeadersVisibility="Column"
                    HorizontalScrollBarVisibility="Disabled"
                    IsReadOnly="True"
                    ItemsSource="{Binding DataViewSource.View}"
                    SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                    SelectionChanged="ImagesDataGrid_SelectionChanged"
                    Tag="{Binding AvailableFiles, RelativeSource={RelativeSource AncestorType=Window}}">
                    <DataGrid.InputBindings>
                        <MouseBinding Command="{Binding ModifyImagesCommand}" Gesture="LeftDoubleClick" />
                    </DataGrid.InputBindings>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem
                                x:Name="ContextMoveImage"
                                Header="Move Image"
                                ItemsSource="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                SubmenuOpened="ContextMoveImage_SubmenuOpened">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Command" Value="{Binding DataContext.MoveImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource Self}}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <Separator />
                            <MenuItem
                                x:Name="ContextAddImage"
                                Command="{Binding AddImagesCommand}"
                                Header="Add Image" />
                            <MenuItem
                                x:Name="ContextModifyImage"
                                Command="{Binding ModifyImagesCommand}"
                                Header="Modify Image" />
                            <MenuItem
                                x:Name="ContextRemoveImage"
                                Command="{Binding RemoveImagesCommand}"
                                Header="Remove Image" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="1*"
                            MinWidth="80"
                            Binding="{Binding EntityID}"
                            Header="Image ID" />
                        <DataGridTextColumn
                            Width="2*"
                            MinWidth="80"
                            Binding="{Binding Name}"
                            Header="Name" />
                        <DataGridTextColumn
                            Width="4*"
                            MinWidth="80"
                            Binding="{Binding Path}"
                            Header="Path (Directory)" />
                        <DataGridTextColumn
                            Width="1*"
                            MinWidth="80"
                            Binding="{Binding IsSynced}"
                            Header="Synced" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid
                x:Name="ButtonContainer"
                Grid.Row="1"
                Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button
                    x:Name="BtnAddImage"
                    Grid.Row="0"
                    Width="240"
                    Margin="5"
                    Padding="2"
                    HorizontalAlignment="Center"
                    Command="{Binding AddImagesCommand}"
                    Content="Add Image Assets"
                    Style="{StaticResource DefaultButton}" />
                <Button
                    x:Name="BtnModifyImage"
                    Grid.Row="1"
                    Width="240"
                    Margin="5"
                    Padding="2"
                    HorizontalAlignment="Center"
                    Command="{Binding ModifyImagesCommand}"
                    Content="Modify Image Assets"
                    Style="{StaticResource DefaultButton}" />
                <Button
                    x:Name="BtnRemoveImage"
                    Grid.Row="2"
                    Width="240"
                    Margin="5"
                    Padding="2"
                    HorizontalAlignment="Center"
                    Command="{Binding RemoveImagesCommand}"
                    Content="Remove Image Assets"
                    Style="{StaticResource ErrorButton}" />
                <Button
                    x:Name="BtnSyncImage"
                    Grid.Row="4"
                    Width="240"
                    Margin="5"
                    Padding="2"
                    HorizontalAlignment="Center"
                    Command="{Binding SaveToScriptCommand}"
                    Content="Sync Image Assets"
                    Style="{StaticResource DefaultButton}" />
                <Button
                    x:Name="BtnImportImage"
                    Grid.Row="5"
                    Width="240"
                    Margin="5"
                    Padding="2"
                    HorizontalAlignment="Center"
                    Command="{Binding ImportImagesCommand}"
                    Content="Import Image Assets"
                    Style="{StaticResource DefaultButton}" />
            </Grid>
        </Grid>
        <Label
            x:Name="ChangesMadeLabel"
            Grid.Row="2"
            Grid.Column="1"
            HorizontalAlignment="Left"
            Content="Changes Made..."
            Visibility="Collapsed" />
        <Button
            x:Name="BtnClose"
            Grid.Row="2"
            Grid.Column="1"
            Width="100"
            Padding="2"
            HorizontalAlignment="Right"
            Command="{Binding ExitCommand}"
            Content="Close"
            Style="{StaticResource DefaultButton}" />
    </Grid>
</Window>
