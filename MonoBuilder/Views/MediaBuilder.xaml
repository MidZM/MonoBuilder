<Window
    x:Class="MonoBuilder.Views.MediaBuilder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
    xmlns:local="clr-namespace:MonoBuilder.Views.ViewUtils"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MonoBuilder.ViewModels.MediaModel"
    xmlns:vmbase="clr-namespace:MonoBuilder.ViewModels"
    Title="MonoBuilder | Media Builder"
    Width="{Binding CurrentWindowWidth, Mode=TwoWay}"
    Height="875"
    d:DataContext="{d:DesignInstance Type=vm:MediaViewModel,
                                     IsDesignTimeCreatable=True}"
    Style="{StaticResource WindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="225" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
                <RowDefinition Height="75" />
            </Grid.RowDefinitions>
            <Image
                x:Name="MediaImage"
                Width="250"
                Height="250"
                Source="/Assets/AudioDefault.png"
                Visibility="Collapsed" />
            <MediaElement
                x:Name="VideoPlayer"
                Margin="10"
                LoadedBehavior="Manual"
                MediaOpened="VideoPlayer_MediaOpened"
                MediaEnded="VideoPlayer_MediaEnded"
                MediaFailed="VideoPlayer_MediaFailed"
                ScrubbingEnabled="{Binding MediaIsVideo}"
                Source="{Binding MediaSource}"
                Stretch="Uniform" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="10,0"
                    Padding="0,0,0,4"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="{Binding CurrentDurationString}" />
                <Slider
                    x:Name="VideoScrubber"
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    Maximum="{Binding TotalMediaDurationSeconds}"
                    Minimum="0"
                    Thumb.DragCompleted="VideoScrubber_DragCompleted"
                    Thumb.DragStarted="VideoScrubber_DragStarted"
                    ValueChanged="VideoScrubber_ValueChanged"
                    Value="{Binding CurrentPositionSeconds, Mode=OneWay}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Thumb.DragStarted">
                            <i:InvokeCommandAction Command="{Binding ScrubberDragStart}" />
                        </i:EventTrigger>
                        <i:EventTrigger EventName="Thumb.DragCompleted">
                            <i:InvokeCommandAction Command="{Binding ScrubberDragComplete}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Slider>
            </Grid>
            <Grid Grid.Row="2" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75" />
                    <ColumnDefinition Width="75" />
                    <ColumnDefinition Width="75" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Padding="2"
                    Command="{Binding PlayCommand}"
                    Style="{StaticResource DefaultButton}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Image
                            Width="50"
                            Height="50"
                            Source="/Assets/Play.png" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    Padding="2"
                    Command="{Binding PauseCommand}"
                    Style="{StaticResource DefaultButton}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Image
                            Width="50"
                            Height="50"
                            Source="/Assets/Pause.png" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    Padding="2"
                    Command="{Binding StopCommand}"
                    Style="{StaticResource DefaultButton}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Image
                            Width="50"
                            Height="50"
                            Source="/Assets/Stop.png" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" MaxWidth="1250">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding EditingContentColumnWidth}" />
            </Grid.ColumnDefinitions>
            <Grid Margin="10,0,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TabControl
                    x:Name="ImageFilterTabs"
                    Grid.Row="0"
                    Height="40"
                    Margin="3,5,3,0"
                    Background="#111111"
                    BorderBrush="Maroon"
                    DockPanel.Dock="Top"
                    ItemsSource="{Binding DataTabs.Tabs}"
                    SelectedItem="{Binding SelectedTab}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Header" Value="{Binding Name}" />
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <TabControl.ContentTemplate>
                        <DataTemplate />
                    </TabControl.ContentTemplate>
                </TabControl>
                <DataGrid
                    x:Name="MediaDataGrid"
                    Grid.Row="1"
                    Width="{Binding TotalWindowWidth}"
                    MaxWidth="970"
                    Margin="{Binding DataGridMargin}"
                    AutoGenerateColumns="False"
                    BorderThickness="{Binding DataGridBorderThickness}"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    DockPanel.Dock="Top"
                    HeadersVisibility="Column"
                    HorizontalScrollBarVisibility="Disabled"
                    IsReadOnly="True"
                    ItemsSource="{Binding DataViewSource.View}"
                    SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                    SelectionChanged="MediaDataGrid_SelectionChanged"
                    Tag="{Binding DataContext.AvailableFiles, RelativeSource={RelativeSource AncestorType=Window}}">
                    <DataGrid.InputBindings>
                        <MouseBinding Command="{Binding ModifyDataCommand}" Gesture="LeftDoubleClick" />
                    </DataGrid.InputBindings>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem
                                x:Name="ContextMoveMedia"
                                Header="Move Image"
                                ItemsSource="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                SubmenuOpened="ContextMoveMedia_SubmenuOpened">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Command" Value="{Binding DataContext.MoveDataCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource Self}}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <Separator />
                            <MenuItem Command="{Binding AddDataCommand}" Header="Add Media" />
                            <MenuItem Command="{Binding ModifyDataCommand}" Header="Modify Media" />
                            <MenuItem Command="{Binding RemoveDataCommand}" Header="Remove Media" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="1*"
                            MinWidth="80"
                            Binding="{Binding EntityID}"
                            Header="Media ID" />
                        <DataGridTextColumn
                            Width="2*"
                            MinWidth="80"
                            Binding="{Binding Name}"
                            Header="Name" />
                        <DataGridTextColumn
                            Width="4*"
                            MinWidth="80"
                            Binding="{Binding Path}"
                            Header="Path (Directory)" />
                        <DataGridTextColumn
                            Width="1*"
                            MinWidth="80"
                            Binding="{Binding IsSynced}"
                            Header="Synced" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button
                    Grid.Row="0"
                    Width="240"
                    Margin="5"
                    Padding="2"
                    HorizontalAlignment="Center"
                    Command="{Binding AddDataCommand}"
                    Content="Add Media Asset"
                    Style="{StaticResource DefaultButton}" />
                <Button
                    Grid.Row="1"
                    Width="240"
                    Margin="5"
                    Padding="2"
                    HorizontalAlignment="Center"
                    Command="{Binding ModifyDataCommand}"
                    Content="Modify Media Asset"
                    Style="{StaticResource DefaultButton}" />
                <Button
                    Grid.Row="2"
                    Width="240"
                    Margin="5"
                    Padding="2"
                    HorizontalAlignment="Center"
                    Command="{Binding RemoveDataCommand}"
                    Content="Remove Media Asset"
                    Style="{StaticResource ErrorButton}" />
                <Button
                    Grid.Row="4"
                    Width="240"
                    Margin="5"
                    Padding="2"
                    HorizontalAlignment="Center"
                    Command="{Binding SaveToScriptCommand}"
                    Content="Sync Media Assets"
                    Style="{StaticResource DefaultButton}" />
                <Button
                    Grid.Row="5"
                    Width="240"
                    Margin="5"
                    Padding="2"
                    HorizontalAlignment="Center"
                    Command="{Binding ImportDataCommand}"
                    Content="Import Media Assets"
                    Style="{StaticResource DefaultButton}" />
            </Grid>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Column="0"
                HorizontalAlignment="Left"
                Content="Changes Made..."
                Visibility="Collapsed" />
            <ComboBox
                Grid.Column="1"
                Width="100"
                Margin="5"
                Padding="2"
                ItemsSource="{Binding MediaModes}"
                SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                Style="{StaticResource DefaultComboBox}" />
            <Button
                Grid.Column="2"
                Width="100"
                Padding="2"
                Command="{Binding ExitCommand}"
                Content="Close"
                Style="{StaticResource DefaultButton}" />
        </Grid>
    </Grid>
</Window>
