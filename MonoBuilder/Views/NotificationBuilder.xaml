<Window
    x:Class="MonoBuilder.Views.NotificationBuilder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MonoBuilder.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:MonoBuilder.Models"
    xmlns:vm="clr-namespace:MonoBuilder.ViewModels.NotifierModel"
    xmlns:vmbase="clr-namespace:MonoBuilder.ViewModels"
    Title="MonoBuilder | Message Builder"
    Width="{Binding CurrentWindowWidth, Mode=TwoWay}"
    Height="650"
    MinWidth="750"
    MinHeight="650"
    d:DataContext="{d:DesignInstance Type=vm:NotifierViewModel,
                                     IsDesignTimeCreatable=True}"
    Style="{StaticResource WindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid x:Name="MainContent" MaxWidth="1250">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{Binding EditingContentColumnWidth}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="EditingContent"
            Grid.Row="0"
            Grid.Column="0"
            IsEnabled="{Binding IsEditingNotifier.Inverse}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="100" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TabControl
                    x:Name="NotificationFilterTabs"
                    Grid.Row="0"
                    Height="40"
                    Margin="3,5,3,0"
                    Background="#111111"
                    BorderBrush="Maroon"
                    ItemsSource="{Binding DataTabs.Tabs}"
                    SelectedItem="{Binding SelectedTab}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Header" Value="{Binding Name}" />
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <TabControl.ContentTemplate>
                        <DataTemplate />
                    </TabControl.ContentTemplate>
                </TabControl>
                <DataGrid
                    Name="NotificationsDataGrid"
                    Grid.Row="1"
                    Width="{Binding TotalWindowWidth}"
                    MaxWidth="800"
                    Margin="{Binding DataGridMargin}"
                    AutoGenerateColumns="False"
                    BorderThickness="{Binding DataGridBorderThickness}"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    HeadersVisibility="Column"
                    HorizontalScrollBarVisibility="Disabled"
                    IsReadOnly="True"
                    ItemsSource="{Binding DataViewSource.View}"
                    SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                    SelectionChanged="NotificationsDataGrid_SelectionChanged"
                    Tag="{Binding DataContext.AvailableFiles, RelativeSource={RelativeSource AncestorType=Window}}">
                    <DataGrid.InputBindings>
                        <MouseBinding Command="{Binding ModifyNotifiersCommand}" Gesture="LeftDoubleClick" />
                    </DataGrid.InputBindings>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem
                                x:Name="ContextMoveNotification"
                                Header="Move Notification"
                                ItemsSource="{Binding PlacementTarget.Tag.AvailableFiles, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                MenuItem.Click="ContextMoveNotification_Click"
                                SubmenuOpened="ContextMoveNotification_SubmenuOpened">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Command" Value="{Binding DataContext.MoveNotifierCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource Self}}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <Separator />
                            <MenuItem
                                x:Name="ContextAddNotification"
                                Command="{Binding AddNotifiersCommand}"
                                Header="Add Notification" />
                            <MenuItem
                                x:Name="ContextModifyNotification"
                                Command="{Binding ModifyNotifiersCommand}"
                                Header="Modify Notification" />
                            <MenuItem
                                x:Name="ContextRemoveNotification"
                                Command="{Binding RemoveNotifiersCommand}"
                                Header="Remove Notification" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="1*"
                            MinWidth="80"
                            Binding="{Binding EntityID}"
                            Header="Instance ID" />
                        <DataGridTextColumn
                            Width="2*"
                            MinWidth="80"
                            Binding="{Binding Name}"
                            Header="Name" />
                        <DataGridTextColumn
                            Width="2*"
                            MinWidth="80"
                            Binding="{Binding Title}"
                            Header="Title" />
                        <DataGridTextColumn
                            Width="1*"
                            MinWidth="80"
                            Binding="{Binding IsSynced}"
                            Header="Synced" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid x:Name="ButtonContainer" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button
                    x:Name="BtnAddNotifier"
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="5"
                    Command="{Binding AddNotifiersCommand}"
                    Content="Add Notifier"
                    Style="{StaticResource DefaultButton}" />
                <Button
                    x:Name="BtnModifyNotifier"
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="5"
                    Command="{Binding ModifyNotifiersCommand}"
                    Content="Update Notifier"
                    Style="{StaticResource DefaultButton}" />
                <Button
                    x:Name="BtnRemoveNotifier"
                    Grid.Row="0"
                    Grid.Column="2"
                    Padding="5"
                    Command="{Binding RemoveNotifiersCommand}"
                    Content="Remove Notifier"
                    Style="{StaticResource ErrorButton}" />
                <Grid Grid.Row="1" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="BtnSyncNotifiers"
                        Grid.Column="0"
                        Padding="5"
                        Command="{Binding SaveToScriptCommand}"
                        Content="Sync Notifiers"
                        Style="{StaticResource DefaultButton}" />
                    <Button
                        x:Name="BtnImportNotifiers"
                        Grid.Column="1"
                        Padding="5"
                        Command="{Binding ImportNotifiersCommand}"
                        Content="Import Notifiers"
                        Style="{StaticResource DefaultButton}" />
                </Grid>
            </Grid>
        </Grid>
        <Grid
            x:Name="NotifierDataContainer"
            Grid.Column="1"
            Margin="5"
            Visibility="{Binding IsEditingNotifier.Inverse, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label
                Grid.Row="0"
                Grid.Column="0"
                Content="Notifier ID:" />
            <Label
                Grid.Row="0"
                Grid.Column="1"
                Content="{Binding SelectedEntity.Name}" />
            <Label
                Grid.Row="0"
                Grid.Column="2"
                Content="File Key:" />
            <Label
                Grid.Row="0"
                Grid.Column="3"
                Content="{Binding SelectedEntity.FileKey}" />
            <avalonEdit:TextEditor
                x:Name="NotifierOutput"
                Grid.Row="1"
                Grid.ColumnSpan="4"
                Background="#111111"
                BorderBrush="Maroon"
                BorderThickness="1"
                Document="{Binding PreviewMessage}"
                Foreground="White"
                HorizontalScrollBarVisibility="Disabled"
                IsReadOnly="True"
                SyntaxHighlighting="MarkDownWithFontSize"
                VerticalScrollBarVisibility="Auto"
                WordWrap="True" />
        </Grid>
        <Grid
            x:Name="NotifierManipultorContainer"
            Grid.Column="1"
            Margin="5"
            Visibility="{Binding IsEditingNotifier.Value, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <Label
                    x:Name="LblMessageID"
                    Grid.Row="0"
                    Content="{Binding BoxNameLabel}" />
                <TextBox
                    x:Name="BoxName"
                    Grid.Row="1"
                    Margin="0"
                    Style="{StaticResource DefaultTextBox}"
                    Tag="{Binding BoxNameTag}"
                    Text="{Binding BoxNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Content="Title" />
                <Label
                    x:Name="LblSubtitle"
                    Grid.Row="0"
                    Grid.Column="1"
                    Content="{Binding BoxSubtitleLabel}" />
                <TextBox
                    x:Name="BoxTitle"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,5,0"
                    Padding="3"
                    Style="{StaticResource DefaultTextBox}"
                    Tag="Enter Title Here..."
                    Text="{Binding BoxTitleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    x:Name="BoxSubtitle"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    Padding="3"
                    Style="{StaticResource DefaultTextBox}"
                    Tag="{Binding BoxSubtitleTag}"
                    Text="{Binding BoxSubtitleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="10*" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Body" />
                <!--<RichTextBox
                    x:Name="RichBoxBody"
                    Grid.Row="1"
                    Background="#111111"
                    Document="{Binding BoxBodyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    BorderBrush="Maroon" />-->
                <avalonEdit:TextEditor
                    x:Name="EditBody"
                    Grid.Row="1"
                    Background="#111111"
                    BorderBrush="Maroon"
                    BorderThickness="1"
                    Document="{Binding BoxBodyText}"
                    Foreground="White"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Auto"
                    WordWrap="True" />
            </Grid>
            <Grid x:Name="EditingRow4" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding BoxCloseGridWidth}" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <Label
                    x:Name="LblCloseButton"
                    Grid.Row="0"
                    Grid.Column="0"
                    Content="Close Button Text — Default &quot;Close&quot;"
                    Visibility="{Binding BoxCloseVisibility}" />
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Content="File" />
                <TextBox
                    x:Name="BoxClose"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,5,0"
                    Padding="3"
                    Style="{StaticResource DefaultTextBox}"
                    Tag="(Optional) Close Button Text..."
                    Text="{Binding BoxCloseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding BoxCloseVisibility}" />
                <ComboBox
                    x:Name="ComboFile"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    ItemsSource="{Binding AvailableFiles}"
                    SelectedIndex="0"
                    SelectedItem="{Binding BoxFileSelectedFile, Mode=TwoWay}"
                    Style="{StaticResource DefaultComboBox}" />
            </Grid>
            <Grid Grid.Row="4" Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BtnSaveClose"
                    Grid.Column="0"
                    Margin="0,0,5,0"
                    Padding="5"
                    Command="{Binding SaveCommand}"
                    Content="Save &amp; Close"
                    Style="{StaticResource DefaultButton}" />
                <Button
                    x:Name="BtnCancel"
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    Padding="5"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    Style="{StaticResource ErrorButton}" />
            </Grid>
        </Grid>
        <Label
            x:Name="ChangesMadeLabel"
            Grid.Row="1"
            Grid.Column="0"
            Margin="5"
            Content="Changes Made!"
            Visibility="Collapsed" />
        <Button
            x:Name="BtnClose"
            Grid.Row="1"
            Grid.Column="1"
            Width="100"
            Margin="5"
            Padding="2"
            HorizontalAlignment="Right"
            Command="{Binding ExitCommand}"
            Content="Close"
            Style="{StaticResource DefaultButton}" />
    </Grid>
</Window>
