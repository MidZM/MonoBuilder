<Window
    x:Class="MonoBuilder.Views.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MonoBuilder.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:MonoBuilder.Models.helpers"
    xmlns:vm="clr-namespace:MonoBuilder.ViewModels.SettingsModel"
    xmlns:vmbase="clr-namespace:MonoBuilder.ViewModels"
    Title="MonoBuilder | Settings"
    Width="{Binding CurrentWindowWidth, Mode=TwoWay}"
    Height="500"
    MinWidth="675"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel,
                                     IsDesignTimeCreatable=True}"
    Style="{StaticResource WindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="10,0,10,0" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <BrushConverter x:Key="BrushConversion" />
        <utils:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <utils:StringIsNotEmpty x:Key="StringIsNotEmpty" />
        <utils:HexToBrushConverter x:Key="HexToBrushConverter" />
        <utils:ShouldLightenText x:Key="ShouldLightenText" />
        <utils:ColorSyncedCells x:Key="ColorSyncedCells" />
        <utils:RegexToString x:Key="RegexToString" />

        <utils:ChainConverters
            x:Key="StringCheckToVisibility"
            Converter1="{StaticResource StringIsNotEmpty}"
            Converter2="{StaticResource InverseBoolToVis}" />

        <DataTemplate DataType="{x:Type vmbase:FolderTabEntry}">
            <DockPanel>
                <Label
                    Content="A Base Folder Must be Selected..."
                    DockPanel.Dock="Top"
                    Visibility="{Binding DataContext.SelectedBasePath.Value, Converter={StaticResource StringCheckToVisibility}, RelativeSource={RelativeSource AncestorType=Window}}" />

                <ItemsControl ItemsSource="{Binding Folders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vmbase:FileEntry}">
                            <Grid Margin="10" DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Content="{Binding Name}" />
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="150"
                                    Height="30"
                                    Margin="0,5,0,5"
                                    Padding="5"
                                    HorizontalAlignment="Right"
                                    Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Key}"
                                    Content="Select"
                                    Style="{StaticResource DefaultButton}" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    FontSize="12"
                                    IsReadOnly="True"
                                    Style="{StaticResource DefaultTextBox}"
                                    Tag="Select a Folder From the &quot;Select&quot; Button..."
                                    Text="{Binding TruncatedPath}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmbase:FileTabEntry}">
            <DockPanel>
                <Label
                    Content="A Base Folder Must be Selected..."
                    DockPanel.Dock="Top"
                    Visibility="{Binding DataContext.SelectedBasePath.Value, Converter={StaticResource StringCheckToVisibility}, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button
                    Height="40"
                    Margin="10"
                    Padding="10"
                    HorizontalAlignment="Right"
                    Command="{Binding AddNewFileCommand}"
                    Content="Add New File"
                    DockPanel.Dock="Top"
                    IsEnabled="{Binding DataContext.SelectedBasePath.Value, Converter={StaticResource StringIsNotEmpty}, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource DefaultButton}" />

                <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vmbase:FileEntry}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="175" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Margin="0,10,10,10"
                                    Padding="5"
                                    Command="{Binding RemoveFileCommand}"
                                    Content="Remove File"
                                    Style="{StaticResource ErrorButton}" />
                                <TextBox
                                    Grid.Column="1"
                                    Margin="0,10,0,10"
                                    FontSize="12"
                                    IsReadOnly="True"
                                    Style="{StaticResource DefaultTextBox}"
                                    Tag="Select a File From the &quot;Select File&quot; Button..."
                                    Text="{Binding TruncatedPath}" />
                                <Button
                                    Grid.Column="2"
                                    Width="150"
                                    Margin="10,10,0,10"
                                    Padding="5"
                                    HorizontalAlignment="Right"
                                    Command="{Binding SelectFileCommand}"
                                    Content="Select File"
                                    Style="{StaticResource DefaultButton}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>
        <DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DockPanel MaxWidth="1250">
                    <DockPanel x:Name="GeneralSettingsContainer" DockPanel.Dock="Top">
                        <Label
                            Content="General Settings"
                            DockPanel.Dock="Top"
                            FontSize="20" />
                        <Label
                            Content="Characters"
                            DockPanel.Dock="Top"
                            FontSize="14" />
                        <Separator
                            Margin="0,10,0,10"
                            Background="Maroon"
                            DockPanel.Dock="Top" />
                        <TabControl
                            x:Name="CharacterFilterTabs"
                            Margin="6,0,6,0"
                            Background="#111111"
                            BorderBrush="Maroon"
                            DockPanel.Dock="Top"
                            ItemsSource="{Binding DataTabs.Tabs}"
                            SelectedItem="{Binding SelectedTab}">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                </Style>
                            </TabControl.ItemContainerStyle>

                            <TabControl.ContentTemplate>
                                <DataTemplate />
                            </TabControl.ContentTemplate>
                        </TabControl>
                        <DataGrid
                            x:Name="CharactersDataGrid"
                            Width="{Binding TotalWindowWidth}"
                            Height="250"
                            MaxWidth="1230"
                            Margin="{Binding DataGridMargin}"
                            AutoGenerateColumns="False"
                            BorderThickness="{Binding DataGridBorderThickness}"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserResizeRows="False"
                            DockPanel.Dock="Top"
                            HeadersVisibility="Column"
                            HorizontalScrollBarVisibility="Disabled"
                            IsReadOnly="True"
                            ItemsSource="{Binding DataViewSource.View}"
                            PreviewMouseWheel="CharactersDataGrid_PreviewMouseWheel"
                            SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                            SelectionChanged="CharactersDataGrid_SelectionChanged"
                            Tag="{Binding DataContext.AvailableFiles, RelativeSource={RelativeSource AncestorType=Window}}">
                            <DataGrid.InputBindings>
                                <MouseBinding Command="{Binding ModifyCharactersCommand}" Gesture="LeftDoubleClick" />
                            </DataGrid.InputBindings>

                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem
                                        x:Name="ContextMoveCharacter"
                                        Header="Move Character"
                                        ItemsSource="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        SubmenuOpened="ContextMoveCharacter_SubmenuOpened">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Command" Value="{Binding DataContext.MoveCharacterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource Self}}" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        x:Name="ContextAddCharacter"
                                        Command="{Binding AddCharactersCommand}"
                                        Header="Add Character" />
                                    <MenuItem
                                        x:Name="ContextModifyCharacter"
                                        Command="{Binding ModifyCharactersCommand}"
                                        Header="Modify Character" />
                                    <MenuItem
                                        x:Name="ContextRemoveCharacter"
                                        Command="{Binding RemoveCharactersCommand}"
                                        Header="Remove Character" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>

                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="{Binding ., Converter={StaticResource ColorSyncedCells}}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    SnapsToDevicePixels="True">
                                                    <ContentPresenter Margin="5" VerticalAlignment="Center" />
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="DarkCyan" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="80"
                                    Binding="{Binding EntityID}"
                                    Header="Character ID" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="80"
                                    Binding="{Binding Name}"
                                    Header="Name" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="80"
                                    Binding="{Binding Tag}"
                                    Header="Tag" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="80"
                                    Binding="{Binding Color}"
                                    Header="Color">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="{Binding Color, Converter={StaticResource HexToBrushConverter}}" />
                                            <Setter Property="Foreground" Value="{Binding Color, Converter={StaticResource ShouldLightenText}}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            SnapsToDevicePixels="True">
                                                            <ContentPresenter Margin="5" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="80"
                                    Binding="{Binding Directory}"
                                    Header="Directory" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock
                            Margin="10,5,10,0"
                            HorizontalAlignment="Center"
                            DockPanel.Dock="Top"
                            FontSize="15"
                            FontWeight="Bold"
                            Text="At Least 1 Script File Must be Selected Before Characters Can be Added or Imported..."
                            TextDecorations="Underline"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasScriptFile, Converter={StaticResource InverseBoolToVis}}" />
                        <Grid
                            x:Name="ButtonsGrid"
                            Height="100"
                            Margin="10,5,10,0"
                            DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button
                                x:Name="BtnAddCharacter"
                                Grid.Row="0"
                                Grid.Column="0"
                                Command="{Binding AddCharactersCommand}"
                                Content="Add Character"
                                Style="{StaticResource DefaultButton}" />
                            <Button
                                x:Name="BtnModifyCharacter"
                                Grid.Row="0"
                                Grid.Column="1"
                                Command="{Binding ModifyCharactersCommand}"
                                Content="Modify Character"
                                Style="{StaticResource DefaultButton}" />
                            <Button
                                x:Name="BtnRemoveCharacter"
                                Grid.Row="0"
                                Grid.Column="2"
                                Command="{Binding RemoveCharactersCommand}"
                                Content="Remove Character"
                                Style="{StaticResource DefaultButton}" />
                            <Grid
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="BtnSaveCharacters"
                                    Grid.Row="1"
                                    Command="{Binding SaveToScriptCommand}"
                                    Content="Save Characters to Script"
                                    Style="{StaticResource DefaultButton}" />
                                <Button
                                    x:Name="BtnImportCharacters"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Command="{Binding ImportCharactersCommand}"
                                    Content="Import Characters"
                                    Style="{StaticResource DefaultButton}" />
                            </Grid>
                        </Grid>
                        <Label
                            Content="Engine Directories"
                            DockPanel.Dock="Top"
                            FontSize="14" />
                        <Separator
                            Margin="0,10,0,10"
                            Background="Maroon"
                            DockPanel.Dock="Top" />
                        <TabControl
                            x:Name="AssetTabs"
                            Margin="10"
                            Padding="10"
                            Background="#111111"
                            BorderBrush="Maroon"
                            DockPanel.Dock="Top"
                            ItemsSource="{Binding MixedEntries.Tabs}">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                </Style>
                            </TabControl.ItemContainerStyle>
                        </TabControl>
                    </DockPanel>

                    <DockPanel
                        x:Name="ScriptBuilderSettingsContainer"
                        Margin="0,20,0,0"
                        DockPanel.Dock="Top">
                        <Label
                            Content="Script Builder Settings"
                            DockPanel.Dock="Top"
                            FontSize="20" />
                        <Label
                            Content="Text Conversions"
                            DockPanel.Dock="Top"
                            FontSize="14" />
                        <Separator
                            Margin="0,10,0,10"
                            Background="Maroon"
                            DockPanel.Dock="Top" />
                        <Grid Margin="10" DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                Content="General Options" />
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="5"
                                    Content="Auto-Sync Labels" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="5,5,5,0"
                                    Content="Color Converted Scripts" />
                                <CheckBox
                                    x:Name="ShouldAutoSync"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="5"
                                    Command="{Binding CheckBoxCommand}"
                                    CommandParameter="{Binding ElementName=ShouldAutoSync}"
                                    Content="Enabled"
                                    IsChecked="{Binding AutoSyncChecked}" />
                                <CheckBox
                                    x:Name="ShouldColor"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="5,5,5,0"
                                    Command="{Binding CheckBoxCommand}"
                                    CommandParameter="{Binding ElementName=ShouldColor}"
                                    Content="Color Script"
                                    IsChecked="{Binding ColorEnabledChecked}" />

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="5,12,5,5"
                                    Content="Indentation Type" />
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="5,12,5,0"
                                    Content="Indentation Amount (Spaces)" />
                                <ComboBox
                                    x:Name="IndentationType"
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="5,5,5,0"
                                    ItemsSource="{Binding IndentationTypes}"
                                    SelectedItem="{Binding SelectedIndentation, Mode=TwoWay}"
                                    Style="{StaticResource DefaultComboBox}" />

                                <TextBox
                                    x:Name="IndentationAmount"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="5,5,5,0"
                                    Style="{StaticResource DefaultTextBox}"
                                    Tag="e.g. 4"
                                    Text="{Binding SpacesAmount, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Grid>
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ConversionRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,0,10,0" DockPanel.Dock="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Column="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            Content="{Binding Name}" />
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                Grid.Column="0"
                                                Margin="5"
                                                VerticalAlignment="Center"
                                                Content="Enabled"
                                                IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox
                                                Grid.Column="1"
                                                Margin="5"
                                                Padding="2"
                                                Text="{Binding PatternString, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style BasedOn="{StaticResource DefaultTextBox}" TargetType="TextBox">

                                                        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />

                                                        <Style.Triggers>
                                                            <Trigger Property="Validation.HasError" Value="True">
                                                                <Setter Property="Background" Value="MistyRose" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </DockPanel>
            </ScrollViewer>
        </DockPanel>
        <Label
            x:Name="ChangesMadeLabel"
            Grid.Row="1"
            Margin="10"
            VerticalAlignment="Center"
            Content="Changes Made"
            Visibility="Collapsed" />
        <StackPanel
            Grid.Row="1"
            Margin="10"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="BtnSave"
                Width="80"
                Command="{Binding SaveDataCommand}"
                Content="Save"
                Style="{StaticResource DefaultButton}" />
            <Button
                x:Name="BtnSaveClose"
                Width="100"
                Command="{Binding SaveDataCommand}"
                CommandParameter="TRUE"
                Content="Save &amp; Close"
                Style="{StaticResource DefaultButton}" />
            <Button
                x:Name="BtnExit"
                Width="80"
                Command="{Binding ExitCommand}"
                Content="Exit"
                IsCancel="True"
                Style="{StaticResource DefaultButton}" />
        </StackPanel>
    </Grid>
</Window>
