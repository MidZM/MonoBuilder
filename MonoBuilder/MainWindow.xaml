<Window
    x:Class="MonoBuilder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MonoBuilder"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MonoBuilder.ViewModels.MainModel"
    Title="MonoBuilder"
    Width="960"
    Height="575"
    MinWidth="900"
    MinHeight="400"
    Padding="25"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel,
                                     IsDesignTimeCreatable=True}"
    Style="{StaticResource WindowStyle}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="Hyperlink">
            <Setter Property="TextDecorations" Value="None" />
            <Setter Property="Foreground" Value="#BB0000" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                    <Setter Property="Foreground" Value="#FF0000" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid
        x:Name="MainGrid"
        MaxWidth="1250"
        Margin="25,25,25,25"
        RenderTransformOrigin="0.58,0.483">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform />
                <SkewTransform />
                <RotateTransform />
                <TranslateTransform />
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding BuilderButtons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Command="{Binding DataContext.OpenBuilderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Content="{Binding Text}"
                            IsEnabled="{Binding IsEnabled}"
                            Style="{StaticResource DefaultButton}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel
            x:Name="Middle_Panel"
            Grid.Column="1"
            Width="320"
            HorizontalAlignment="Center">
            <ItemsControl ItemsSource="{Binding UtilityButtons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button
                                x:Name="UtilityButton"
                                Width="{Binding Width}"
                                Height="{Binding Height}"
                                Padding="{Binding Padding}"
                                Command="{Binding DataContext.RunUtilityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                DockPanel.Dock="Top"
                                Style="{StaticResource DefaultButton}">
                                <Image
                                    Width="{Binding ImgWidth}"
                                    Height="{Binding ImgHeight}"
                                    d:Source="/Assets/fallback.jpg"
                                    Source="{Binding Source}" />
                            </Button>
                            <Label
                                HorizontalAlignment="Center"
                                Content="{Binding LabelText}"
                                DockPanel.Dock="Top"
                                Visibility="{Binding ElementName=UtilityButton, Path=IsMouseOver, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <Grid
            x:Name="Right_Panel"
            Grid.Column="2"
            Grid.ColumnSpan="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Row="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <Hyperlink
                    x:Name="VersionInfo"
                    Command="{Binding OpenVersionInfoCommand}"
                    FontWeight="Bold">
                    Version Information
                </Hyperlink>
            </TextBlock>
            <Image
                Grid.Row="1"
                Grid.Column="0"
                Source="Assets/Zone Master Productions Logo.png" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                MinWidth="100"
                MinHeight="250"
                HorizontalAlignment="Center">
                <Hyperlink
                    x:Name="ImageLink"
                    Command="{Binding OpenSteamStoreCommand}"
                    CommandParameter="https://store.steampowered.com/app/1977000/Symbiotic_Invasion/">
                    <Grid>
                        <Image
                            MinWidth="100"
                            MinHeight="250"
                            Source="Assets/Symbiotic_Cover2.jpg"
                            Stretch="Uniform" />
                        <Rectangle
                            Grid.Row="2"
                            Grid.Column="0"
                            MinWidth="100"
                            MinHeight="250"
                            Fill="Black"
                            Opacity="0.25">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TextBlock}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Grid>
                </Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
